# Required by docker-compose. Store the real value in the deployment secret store.
AGRI_VISION_API_KEY=replace-with-a-long-random-value
# Optional validated model worker. Leave unset to keep inference in pending_model.
AGRI_VISION_INFERENCE_URL=
AGRI_VISION_INFERENCE_API_KEY=
AGRI_VISION_INFERENCE_MODEL_VERSION=external-unconfigured
AGRI_VISION_INFERENCE_TIMEOUT=10
# Required only for docker-compose.production.yml. Use a DNS name pointing to this host.
AGRI_VISION_DOMAIN=agri.example.com
# Optional contact email for certificate notices from Caddy.
CADDY_EMAIL=ops@example.com
